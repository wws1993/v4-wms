# 开发时请求发往 /api，由 Vite 去掉前缀后转发到丰联开发环境。
VITE_API_BASE=/api
# OCR 模拟开关：true 使用本地样例，false 调用后端 OCR 接口。
VITE_OCR_MOCK=true
# VITE_OCR_MOCK=false
# VITE_PROXY_TARGET=http://47.108.190.246:8090
VITE_PROXY_TARGET=http://127.0.0.1:8090
# 勇哥
# VITE_PROXY_TARGET=http://g6a4dcbe.natappfree.cc
# 刘哥
# VITE_PROXY_TARGET=http://daf5dc62.natappfree.cc
# 令牌前缀。丰联若依默认 Bearer。若后端不要前缀，设为空字符串。
# VITE_TOKEN_PREFIX=Bearer
# 系统参数主键，对应 GET /wms/system/params
# VITE_SYSTEM_PARAM_ID=1
