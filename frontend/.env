# 登录、验证码、退出始终请求丰联。改为 false 后，只有 VITE_LIVE_MODULES 里的模块请求丰联。
# 矿源备案、驾驶舱汇总、移库、库存、盘点、生产、出库、关务仍走本地 mock。平面图 JSON 走丰联。
VITE_USE_MOCK=false
# 已验收并放行的模块。逗号分隔：auth,settings,warehouses,stacks,materials,partners,bonded,shipping,inbound,ocr,audit,dicts,floor
VITE_LIVE_MODULES=auth,settings,warehouses,stacks,materials,partners,bonded,shipping,inbound,ocr,audit,dicts,floor
# 开发时请求发往 /api，由 Vite 去掉前缀后转发到丰联开发环境。
VITE_API_BASE=/api
VITE_PROXY_TARGET=http://47.108.190.246:8090
# 令牌前缀。丰联若依默认 Bearer。若后端不要前缀，设为空字符串。
# VITE_TOKEN_PREFIX=Bearer
# 系统参数主键，对应 GET /wms/system/params/{id}
# VITE_SYSTEM_PARAM_ID=1
