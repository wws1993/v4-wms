paths:
  /wms/warehouse:
    put:
      summary: 修改仓库
      deprecated: false
      description: 修改仓库
      operationId: edit
      tags:
        - 仓库管理
      parameters: []
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                id:
                  type: integer
                  description: id
                  format: int64
                warehouseCode:
                  type: string
                  description: 编号
                warehouseName:
                  type: string
                  description: 名称
                storageCapacity:
                  type: number
                  description: 库容（吨）
                area:
                  type: number
                  description: 面积（㎡）
                status:
                  type: string
                  description: 状态
                remark:
                  type: string
                  description: 备注
                orderNum:
                  type: integer
                  description: 排序
                  format: int64
              required:
                - id
            examples: {}
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                $ref: '#/components/schemas/RVoid'
          headers: {}
      security:
        - apiKey: []
    post:
      summary: 新增仓库
      deprecated: false
      description: 新增仓库
      operationId: add
      tags:
        - 仓库管理
      parameters: []
