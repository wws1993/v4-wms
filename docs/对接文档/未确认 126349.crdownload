          type: string
          description: 组件地址
        query:
          type: string
          description: '路由参数：如 {"id": 1, "name": "ry"}'
        alwaysShow:
          type: boolean
          description: 当你一个路由下面的 children 声明的路由大于1个时，自动会变成嵌套的模式--如组件页面
