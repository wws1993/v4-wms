                  type: string
                  description: 编号
                warehouseName:
                  type: string
                  description: 名称
                storageCapacity:
                  type: number
                  description: 库容（吨）
                area:
                  type: number
                  description: 面积（㎡）
                status:
                  type: string
                  description: 状态
                remark:
                  type: string
                  description: 备注
                orderNum:
                  type: integer
                  description: 排序
                  format: int64
            examples: {}
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                $ref: '#/components/schemas/RVoid'
          headers: {}
      security:
        - apiKey: []
