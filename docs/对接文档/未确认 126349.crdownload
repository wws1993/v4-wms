webhooks: {}
components:
  schemas:
    WarehouseBo:
      required:
        - id
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        id:
          type: integer
          description: id
          format: int64
        warehouseCode:
          type: string
          description: 编号
        warehouseName:
          type: string
          description: 名称
        storageCapacity:
          type: number
          description: 库容（吨）
        area:
          type: number
          description: 面积（㎡）
        status:
          type: string
          description: 状态
        remark:
          type: string
          description: 备注
        orderNum:
          type: integer
          description: 排序
          format: int64
    RVoid:
      type: object
      properties:
        code:
          type: integer
          format: int32
        msg:
          type: string
        data:
          type: object
          properties: {}
      description: 响应信息主体
    SystemElementBo:
      required:
        - elementCode
        - elementName
        - isHarmful
        - isRequired
        - isTaxDeclared
      type: object
      properties:
        elementCode:
          type: string
          description: 编号
        elementName:
          type: string
          description: 名称
        isRequired:
          type: string
          description: 是否必填(0 否 1 是)
        isHarmful:
          type: string
          description: 是否有害元素(0 否 1 是)
        isTaxDeclared:
          type: string
          description: 是否报税元素(0 否 1 是)
      description: 品质参数配置
    SystemParamBo:
      required:
        - agingAlert
        - dockAlert
        - thresholdAlter
        - usageAlert
      type: object
      properties:
        thresholdAlter:
          type: integer
          description: 库存预警阈值（库容占用%）
          format: int32
        agingAlert:
          type: integer
          description: 原料库龄预警（天）
          format: int32
        dockAlert:
          type: integer
          description: 码头仓库预警（天）
          format: int32
        usageAlert:
          type: integer
          description: 矿源备案用量预警（%）
          format: int32
        elements:
          type: array
          description: 品质参数配置
          items:
            $ref: '#/components/schemas/SystemElementBo'
      description: 系统参数
    ShippingMethodBo:
      required:
        - id
        - shippingMethodCode
        - shippingMethodName
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        id:
          type: integer
          format: int64
        shippingMethodCode:
          type: string
          description: 编码
        shippingMethodName:
          type: string
          description: 名称
        areaNumber:
          type: integer
          description: 柜数
          format: int32
      description: 装运方式
    ReceiptOrderDetailBo:
      required:
        - dryWeight
        - id
        - mineralType
        - moistureContent
        - receiptOrdeCode
        - shippingMethodId
        - wetWeight
      type: object
      properties:
        id:
          type: integer
          description: 入库单ID
          format: int64
        receiptOrdeCode:
          type: string
          description: 入库单号
        mineralType:
          type: integer
          description: 矿种
          format: int32
        shippingMethodId:
          type: integer
          description: 装运方式
          format: int64
        wetWeight:
          type: number
          description: 湿重(吨)
        dryWeight:
          type: number
          description: 干重(吨)
        moistureContent:
          type: number
          description: 水分
        itemType:
          type: integer
          description: 分类
          format: int32
        ebookId:
          type: integer
          description: 账册id
          format: int64
        remark:
          type: string
          description: 备注
        weightOrcId:
          type: integer
          description: OCR入库重量单主键
          format: int64
        elementsOrcId:
          type: integer
          description: OCR入库重量单主键
          format: int64
        elements:
          type: array
          description: 五项有害元素
          items:
            $ref: '#/components/schemas/ReceiptOrderElementBo'
      description: 入库单-收货
    ReceiptOrderElementBo:
      required:
        - elementCode
        - elementValue
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        elementCode:
          type: string
          description: 编号
        elementValue:
          type: number
          description: 值
      description: 入库单-五项有害元素
    OcrLogBo:
      required:
        - id
        - ocrLogType
      type: object
      properties:
        id:
          type: integer
          format: int64
        ocrLogType:
          type: integer
          description: 类型 0 入库报关单 1 出库报关单 2 重量单 3 品质单
          format: int64
        orderId:
          type: integer
          description: 关联单号(只归档填写0, 回填归档时填报关单ID/重量单ID/品质单ID)
          format: int64
        orderNo:
          type: string
          description: 关联单号
        ocrLogStatus:
          type: integer
          description: 状态(0待修正2回填3归档)
          format: int32
        result:
          type: object
          additionalProperties:
            type: object
          description: 识别结果(回填归档时填写对应值，会修改相关单据信息)
          properties: {}
      description: OCR 编辑对象
    MerchantBo:
      required:
        - id
        - merchantCode
        - merchantName
        - merchantType
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        id:
          type: integer
          description: id
          format: int64
        merchantCode:
          type: string
          description: 编号
        merchantName:
          type: string
          description: 名称
        merchantType:
          type: integer
          description: 角色
          format: int32
        mobile:
          type: string
          description: 联系电话
        contactPerson:
          type: string
          description: 联系人
        status:
          type: string
          description: 状态
        remark:
          type: string
          description: 备注
        source:
          type: integer
          description: 来源 （0 手工维护 1 入库自动录入 2 出库自动录入）
          format: int32
      description: 往来单位业务对象 wms_merchant
    AreaBo:
      required:
        - areaName
        - id
        - inventoryCapacity
        - warehouseId
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        id:
          type: integer
          description: id
          format: int64
        areaCode:
          type: string
          description: 编号
        areaName:
          type: string
          description: 名称
        warehouseId:
          type: integer
          description: 所属仓库ID
          format: int64
        inventoryCapacity:
          type: number
          description: 库容（吨）
        areaIdentification:
          type: string
          description: 片区标识
        status:
          type: string
          description: 状态
        remark:
          type: string
          description: 备注
    SysDept:
      required:
        - deptName
        - orderNum
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        deptId:
          type: integer
          description: 部门ID
          format: int64
        deptName:
          maxLength: 30
          minLength: 0
          type: string
          description: 部门名称
        orderNum:
          type: integer
          description: 显示顺序
          format: int32
        leader:
          type: string
          description: 负责人
        phone:
          maxLength: 11
          minLength: 0
          type: string
          description: 联系电话
        email:
          maxLength: 50
          minLength: 0
          type: string
          description: 邮箱
        status:
          type: string
          description: 部门状态:0正常,1停用
        delFlag:
          type: string
          description: 删除标志（0代表存在 1代表删除）
        ancestors:
          type: string
          description: 祖级列表
        parentName:
          type: string
          description: 父菜单名称
        parentId:
          type: integer
          description: 父菜单ID
          format: int64
        children:
          type: array
          description: 子部门
          items:
            $ref: '#/components/schemas/SysDept'
      description: 部门表 sys_dept
    SysRole:
      required:
        - roleKey
        - roleName
        - roleSort
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        roleId:
          type: integer
          description: 角色ID
          format: int64
        roleName:
          maxLength: 30
          minLength: 0
          type: string
          description: 角色名称
        roleKey:
          maxLength: 100
          minLength: 0
          type: string
          description: 角色权限
        roleSort:
          type: integer
          description: 角色排序
          format: int32
        dataScope:
          type: string
          description: 数据范围（1：所有数据权限；2：自定义数据权限；3：本部门数据权限；4：本部门及以下数据权限；5：仅本人数据权限）
        menuCheckStrictly:
          type: boolean
          description: 菜单树选择项是否关联显示（ 0：父子不互相关联显示 1：父子互相关联显示）
        deptCheckStrictly:
          type: boolean
          description: 部门树选择项是否关联显示（0：父子不互相关联显示 1：父子互相关联显示 ）
        status:
          type: string
          description: 角色状态（0正常 1停用）
        delFlag:
          type: string
          description: 删除标志（0代表存在 1代表删除）
        remark:
          type: string
          description: 备注
        flag:
          type: boolean
          description: 用户是否存在此角色标识 默认不存在
        menuIds:
          type: array
          description: 菜单组
          items:
            type: integer
            format: int64
        deptIds:
          type: array
          description: 部门组（数据权限）
          items:
            type: integer
            format: int64
        admin:
          type: boolean
      description: 角色表 sys_role
    AccountBookBo:
      required:
        - accountCode
        - accountName
        - id
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        id:
          type: integer
          description: id
          format: int64
        accountCode:
          type: string
          description: 账册编号
        accountName:
          type: string
          description: 账册名称
        operatingUnit:
          type: string
          description: 经营单位
        goodsValue:
          type: number
          description: 货值
        customsDeclarationNumber:
          type: string
          description: 报关单号
        filingStatus:
          type: string
          description: 备案状态
        oldAccountId:
          type: integer
          description: 衔接旧账ID
          format: int64
        remark:
          type: string
          description: 备注
        beginEarlyWarningTime:
          type: string
          description: 旧账册预警日期
        endEarlyWarningTime:
          type: string
          description: 旧账册预警日期
    SysUserBo:
      required:
        - nickName
        - userName
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        userId:
          type: integer
          description: 用户ID
          format: int64
        deptId:
          type: integer
          description: 部门ID
          format: int64
        userName:
          maxLength: 30
          minLength: 0
          type: string
          description: 用户账号
        nickName:
          maxLength: 30
          minLength: 0
          type: string
          description: 用户昵称
        userType:
          type: string
          description: 用户类型（sys_user系统用户）
        email:
          maxLength: 50
          minLength: 0
          type: string
          description: 用户邮箱
        phonenumber:
          type: string
          description: 手机号码
        sex:
          type: string
          description: 用户性别
        avatar:
          type: string
          description: 用户头像
        password:
          type: string
          description: 密码
        status:
          type: string
          description: 帐号状态（0正常 1停用）
        delFlag:
          type: string
          description: 删除标志（0代表存在 1代表删除）
        loginIp:
          type: string
          description: 最后登录IP
        loginDate:
          type: string
          description: 最后登录时间
          format: date-time
        remark:
          type: string
          description: 备注
        dept:
          $ref: '#/components/schemas/SysDept'
        roles:
          type: array
          description: 角色对象
          items:
            $ref: '#/components/schemas/SysRole'
        roleIds:
          type: array
          description: 角色组
          items:
            type: integer
            format: int64
        postIds:
          type: array
          description: 岗位组
          items:
            type: integer
            format: int64
        roleId:
          type: integer
          description: 数据权限 当前角色ID
          format: int64
        admin:
          type: boolean
    SysUserProfileBo:
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
          description: 更新者
        updateTime:
          type: string
          description: 更新时间
          format: date-time
        params:
          type: object
          additionalProperties:
            type: object
          description: 请求参数
          properties: {}
        nickName:
          maxLength: 30
          minLength: 0
          type: string
          description: 用户昵称
        email:
          maxLength: 50
          minLength: 0
          type: string
          description: 用户邮箱
        phonenumber:
          pattern: (?:0|86|\+86)?1[3-9]\d{9}
          type: string
          description: 手机号码
        sex:
          type: string
          description: 用户性别（0男 1女 2未知）
      description: 个人信息业务处理
    SysRoleBo:
      required:
        - roleKey
        - roleName
        - roleSort
      type: object
      properties:
        createBy:
          type: string
          description: 创建者
        createTime:
          type: string
          description: 创建时间
          format: date-time
        updateBy:
          type: string
