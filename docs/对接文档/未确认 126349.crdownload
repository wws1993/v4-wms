  /wms/receiptOrder:
    put:
      summary: 到货收货
      deprecated: false
      description: 到货收货
      operationId: edit_3
      tags:
        - 入库单
      parameters: []
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                id:
                  type: integer
                  description: 入库单ID
                  format: int64
                receiptOrdeCode:
                  type: string
                  description: 入库单号
                mineralType:
                  type: integer
                  description: 矿种
                  format: int32
                shippingMethodId:
                  type: integer
                  description: 装运方式
                  format: int64
                wetWeight:
                  type: number
                  description: 湿重(吨)
                dryWeight:
                  type: number
                  description: 干重(吨)
                moistureContent:
                  type: number
                  description: 水分
                itemType:
                  type: integer
                  description: 分类
                  format: int32
                ebookId:
                  type: integer
                  description: 账册id
                  format: int64
                remark:
                  type: string
                  description: 备注
                weightOrcId:
                  type: integer
                  description: OCR入库重量单主键
                  format: int64
                elementsOrcId:
                  type: integer
                  description: OCR入库重量单主键
                  format: int64
                elements:
                  type: array
                  description: 五项有害元素
                  items:
                    $ref: '#/components/schemas/ReceiptOrderElementBo'
              required:
                - id
                - receiptOrdeCode
                - mineralType
                - shippingMethodId
                - wetWeight
                - dryWeight
                - moistureContent
            examples: {}
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                $ref: '#/components/schemas/RVoid'
          headers: {}
      security:
        - apiKey: []
    post:
      summary: 新建入库预约
      deprecated: false
      description: 新建入库预约
      operationId: add_3
      tags:
        - 入库单
      parameters: []
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                orcId:
                  type: integer
                  description: OCR入库报关单主键
                  format: int64
                consignorId:
                  type: integer
                  description: 委托方
                  format: int64
                shipName:
                  type: integer
                  description: 船名
                  format: int64
                waybillNo:
                  type: string
                  description: 提运单号
                verificationCode:
                  type: string
                  description: 核注清单号
                recordNo:
                  type: string
                  description: 报关单号
                currency:
                  type: string
                  description: 币制
                payableAmount:
                  type: number
                  description: 订单金额
                itemId:
                  type: integer
                  description: 物料id
                  format: int64
                itemBookId:
                  type: integer
                  description: 物料备案id
                  format: int64
                areaId:
                  type: integer
                  description: 堆位id
                  format: int64
                mineralType:
                  type: integer
                  description: 矿种
                  format: int32
                shippingMethodId:
                  type: integer
                  description: 装运方式
                  format: int32
                arrivalDate:
                  type: string
                  description: 到货日期
                  format: date-time
                entityId:
                  type: integer
                  description: 物流账册主体id
                  format: int64
                ebookId:
                  type: integer
                  description: 账册id
                  format: int64
                areas:
                  type: array
                  description: 存放位置
                  items:
                    $ref: '#/components/schemas/AreaItemBo'
              required:
                - orcId
                - consignorId
                - payableAmount
                - itemId
                - itemBookId
                - areaId
                - mineralType
                - shippingMethodId
            examples: {}
        required: true
      responses:
        '200':
          description: OK
          content:
            '*/*':
              schema:
                $ref: '#/components/schemas/RReceiptOrderVo'
          headers: {}
      security:
        - apiKey: []
